{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazekker.local/schemas/orientation-object.schema.json",
  "title": "JAZEKKER Canonical Orientation Object",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "summary",
    "signal",
    "context",
    "impact",
    "confidence_score",
    "risk_level",
    "orientation_score",
    "recommended_action",
    "rubric",
    "sources",
    "source_count",
    "status",
    "created_at",
    "updated_at",
    "review_required",
    "governance_notes",
    "human_approved",
    "human_reviewer",
    "publication_target"
  ],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "signal": {"type": "string"},
    "context": {"type": "string"},
    "impact": {"type": "string"},
    "confidence_score": {"type": "number", "minimum": 0, "maximum": 100},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "orientation_score": {"type": "number", "minimum": 0, "maximum": 100},
    "recommended_action": {"type": "string"},
    "rubric": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "publisher", "timestamp", "confidence", "extraction_metadata"],
        "properties": {
          "url": {"type": "string"},
          "publisher": {"type": "string"},
          "title": {"type": "string"},
          "timestamp": {"type": "string"},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "source_type": {"type": "string"},
          "extraction_metadata": {"type": "object"}
        }
      }
    },
    "source_count": {"type": "integer"},
    "status": {
      "type": "string",
      "enum": [
        "collected",
        "classified",
        "drafted",
        "review_required",
        "approved",
        "scheduled",
        "published_local",
        "published_external",
        "blocked",
        "archived"
      ]
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "review_required": {"type": "boolean"},
    "governance_notes": {"type": "string"},
    "human_approved": {"type": "boolean"},
    "human_reviewer": {"type": ["string", "null"]},
    "publication_target": {"type": "string", "enum": ["local", "external", "none"]},
    "governance_status": {"type": "string"},
    "policy_applied": {"type": "string"},
    "risk_reason": {"type": "string"},
    "approval_required": {"type": "boolean"},
    "approval_timestamp": {"type": ["string", "null"]},
    "review_notes": {"type": "string"},
    "generated_draft": {"type": "string"},
    "rollback": {"type": "object"}
  }
}
