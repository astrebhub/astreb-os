{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazekker.nl/schemas/orientation-object.schema.json",
  "title": "JAZEKKER Orientation Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "language",
    "created_at",
    "updated_at",
    "signal",
    "context",
    "noise_level",
    "impact_horizon",
    "who_should_care",
    "systemic_effects",
    "next_orientation_step",
    "sources",
    "confidence",
    "governance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^oo-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 140
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_sources",
        "needs_governance_review",
        "reviewed",
        "approved",
        "scheduled",
        "published",
        "blocked",
        "archived"
      ]
    },
    "language": {
      "type": "string",
      "enum": ["en", "nl", "ru"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "signal_type", "why_now"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "signal_type": {
          "type": "string",
          "enum": [
            "policy",
            "technology",
            "market",
            "social",
            "infrastructure",
            "research",
            "governance",
            "community",
            "project"
          ]
        },
        "why_now": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "context": {
      "type": "string",
      "minLength": 40
    },
    "noise_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "impact_horizon": {
      "type": "string",
      "enum": ["now", "weeks", "months", "years"]
    },
    "who_should_care": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "systemic_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "next_orientation_step": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale", "last_checked"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "last_checked": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "sensitive_domains",
        "approval_required",
        "approval_status",
        "ai_assisted",
        "human_reviewer",
        "audit_ids"
      ],
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "sensitive_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["political", "legal", "medical", "financial", "reputational", "privacy", "security"]
          }
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval_status": {
          "type": "string",
          "enum": ["not_requested", "pending", "approved", "rejected", "blocked"]
        },
        "ai_assisted": {
          "type": "boolean"
        },
        "human_reviewer": {
          "type": ["string", "null"]
        },
        "audit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {
          "$ref": "#/$defs/distributionDraft"
        },
        "newsletter": {
          "$ref": "#/$defs/distributionDraft"
        },
        "linkedin": {
          "$ref": "#/$defs/distributionDraft"
        },
        "telegram": {
          "$ref": "#/$defs/distributionDraft"
        },
        "rss": {
          "$ref": "#/$defs/distributionDraft"
        }
      }
    },
    "strategic_memory_note": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "source_type", "publisher", "published_at", "last_checked", "confidence"],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "type": "string",
          "enum": ["primary", "official", "expert", "media", "community", "internal", "unknown"]
        },
        "publisher": {
          "type": "string"
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date"
        },
        "last_checked": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "distributionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "draft_path"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "draft", "approved", "scheduled", "published", "blocked"]
        },
        "draft_path": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
