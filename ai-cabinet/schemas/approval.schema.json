{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jazekker.nl/schemas/approval.schema.json",
  "title": "JAZEKKER Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object_id",
    "approval_type",
    "status",
    "requested_by",
    "requested_at",
    "decision_by",
    "decision_at",
    "rationale"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^approval-[a-z0-9-]+$"
    },
    "object_id": {
      "type": "string"
    },
    "approval_type": {
      "type": "string",
      "enum": ["editorial", "governance", "distribution", "memory", "correction"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "blocked"]
    },
    "requested_by": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_by": {
      "type": ["string", "null"]
    },
    "decision_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "rationale": {
      "type": "string"
    }
  }
}
